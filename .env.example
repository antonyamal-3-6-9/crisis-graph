# Database and distributed coordination
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# OpenAI-compatible triage endpoint. Use `llama-cpp` or `vllm`.
INFERENCE_BACKEND=llama-cpp
INFERENCE_BASE_URL=http://localhost:8000/v1
INFERENCE_MODEL=Qwen/Qwen3-4B-Instruct-2507
INFERENCE_TIMEOUT_SECS=60
# INFERENCE_API_KEY=

# Audit metadata. These values do not load the adapter into the inference server.
TRIAGE_ADAPTER_ID=qwen3-4b-triage-sft-v3
TRIAGE_ADAPTER_SHA256=bcec4e21b232174b89dcd0dd2a800212136488ed32d962e810babae9efa18039

APP_ENV=development
LOG_LEVEL=info
