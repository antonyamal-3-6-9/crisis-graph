# Database and distributed coordination
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# OpenAI-compatible triage endpoint: `llama-cpp`, `vllm`, or `openai` for a
# hosted OpenAI-compatible API. `simulated` (load tests only) skips the model:
# the surge tool's ground-truth tag is returned after SIM_EXTRACTION_MEDIAN_MS.
#
# Hosted example (M8 run B; synthetic reports only, never the frozen test sets):
#   INFERENCE_BACKEND=openai
#   INFERENCE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   INFERENCE_MODEL=gemini-2.5-flash-lite
#   INFERENCE_API_KEY=<set only in the triage process environment>
#   INFERENCE_MAX_RPM=10           # stay under the free-tier request rate
#   TRIAGE_ADAPTER_ID=             # no LoRA adapter on a hosted model
INFERENCE_BACKEND=llama-cpp
INFERENCE_BASE_URL=http://localhost:8000/v1
INFERENCE_MODEL=Qwen/Qwen3-4B-Instruct-2507
INFERENCE_TIMEOUT_SECS=60
# Concurrent inference requests per triage worker. Keep at 1-2 for llama.cpp on CPU
# and match llama-server's -np (parallel slots).
INFERENCE_MAX_CONCURRENCY=1
# INFERENCE_API_KEY=
# INFERENCE_MAX_RPM=0              # requests per minute per triage worker; 0 = unlimited (429s are retried)
# SIM_EXTRACTION_MEDIAN_MS=800     # simulated backend: median latency (log-normal, seeded per report)

# Audit metadata. These values do not load the adapter into the inference server.
# The extractor sends schema V3 + prompt v3.2, which SFT-V4 was trained with.
TRIAGE_ADAPTER_ID=qwen3-4b-triage-sft-v4
TRIAGE_ADAPTER_SHA256=f31100c925b3b2f4540f481be0f9338d5024ca931c0368265f6b16eb5f520fbc

# Hazard command operators (api role), comma-separated actor_id:ROLE[+ROLE]:sha256hex.
# The hex is the SHA-256 of the operator's bearer token (printf %s "$TOKEN" | sha256sum).
# Roles: OBSERVER, DISPATCHER, HAZARD_VERIFIER, RESPONDER, EOC_ADMIN. Empty: every request gets 401.
# OPERATOR_TOKENS=asha:HAZARD_VERIFIER:<sha256 hex>

APP_ENV=development
LOG_LEVEL=info

# Pipeline parameters (all optional; defaults shown). Invalid values fall back
# to the default. See docs/internal/incident-pipeline-architecture §4.10.
# DEDUP_SAME_DEVICE_WINDOW_SECS=1800
# DEDUP_NEARBY_RADIUS_M=100
# DEDUP_NEARBY_WINDOW_SECS=3600
# ON_SCENE_RADIUS_M=500             # F-1: caller within this (+ GPS accuracy) of the described place is on scene
# STREAM_CLAIM_IDLE_MS=60000        # set to ~3x p99 extraction latency on your CPU
# STREAM_MAX_RETRIES=5
# RETRY_BACKOFF_INITIAL_MS=1000
# RETRY_BACKOFF_MAX_MS=30000
# OUTBOX_POLL_MS=250
# OUTBOX_BATCH_SIZE=100
# OUTBOX_RETENTION_DAYS=7
# MATCHER_CYCLE_MS=2000
# MATCHER_DEBOUNCE_MS=250
# HOLD_EXPIRY_SECS=30
# AGING_STABLE_TO_URGENT_SECS=1800
# ESCALATE_CRITICAL_SECS=180
# ESCALATE_URGENT_SECS=600
# ESCALATE_STABLE_SECS=1800
# RESERVE_AHEAD_SECS=600
# JIT_MARGIN_SECS=120
# MATCHER_BATCH_CAP=200           # most queued tasks taken into one matcher cycle
# MATCHER_REBUILD_SECS=30          # matcher: periodic rebuild of alloc:queue from Neo4j
# MATCHER_MAX_VERIFY_FAILURES=3    # failed live route checks before a task is escalated
# LEASE_TTL_MS=10000
# LEASE_RENEW_MS=3000
# BREAKER_CONSECUTIVE_FAILURES=5
# BREAKER_ERROR_RATE=0.5
# BREAKER_WINDOW_SECS=30
# BREAKER_HALF_OPEN_SECS=30
# OVERLAY_REFRESH_SECS=30          # graph role: fallback hazard-overlay refresh
# GRAPH_DATASET=aluva-periyar-pilot # baseline the graph role loads; default dataset of the hazard API
# ROLE_DRAIN_TIMEOUT_SECS=10
# BOAT_SPEED_KMH=8                # boat-then-road missions: assumed boat speed for water-leg estimates
# SIM_TIME_SCALE=0.1             # driver role (demo only): mission time multiplier
# SIM_ON_SCENE_SECS=300          # driver role: simulated time on scene
# DISPATCH_WAIT_SECS=180          # api: longest POST /api/v1/dispatch waits for an outcome

# Observability (M8). Spans are exported over OTLP/HTTP only when the endpoint
# is set (Jaeger: ops/run-jaeger.sh listens on 4318). The console links to
# Grafana and Jaeger when their URLs are set.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# GRAFANA_URL=http://localhost:3300/d/crisisgraph-pipeline
# JAEGER_URL=http://localhost:16686
# EXTRACT_STREAM=sos:extract
# EVENTS_STREAM=ops:events
