{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crisisgraph.local/schemas/triage-extraction-v3.json",
  "title": "CrisisGraph Triage Extraction V3",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "triage-extraction-v3"
    },
    "victim_location": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 500
    },
    "victim_location_raw": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 500
    },
    "headcount": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        {
          "type": "null"
        }
      ]
    },
    "required_asset": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "RESCUE_BOAT",
            "AMBULANCE",
            "EVAC_TRUCK",
            "HELICOPTER"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "hazards": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "road_segment": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 200
          },
          "status": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "FLOODED",
                  "BLOCKED",
                  "OPEN"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "duration_hours": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 168
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "road_segment",
          "status",
          "duration_hours"
        ]
      }
    },
    "confidence_score": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "needs_human_review": {
      "type": "boolean"
    },
    "uncertainty_reasons": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "victim_profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reporter_relation": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "SELF",
                "HOUSEHOLD",
                "THIRD_PARTY",
                "UNDER_REVIEW"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "reporter_on_scene": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "medical_conditions": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 6,
          "items": {
            "type": "string",
            "enum": [
              "UNCONSCIOUS",
              "BREATHING_DIFFICULTY",
              "CARDIAC",
              "BLEEDING",
              "INJURY",
              "CHRONIC_CARE"
            ]
          }
        },
        "other_conditions": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "vulnerable_groups": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 6,
          "items": {
            "type": "string",
            "enum": [
              "CHILD",
              "INFANT",
              "ELDERLY",
              "PREGNANT",
              "DISABLED",
              "BEDRIDDEN"
            ]
          }
        },
        "water_level": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "ANKLE",
                "KNEE",
                "WAIST",
                "CHEST",
                "ABOVE_HEAD",
                "ROOF"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "water_trend": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "RISING",
                "STABLE",
                "FALLING"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "suggested_urgency": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "CRITICAL",
                "URGENT",
                "STABLE"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "reporter_relation",
        "reporter_on_scene",
        "medical_conditions",
        "other_conditions",
        "vulnerable_groups",
        "water_level",
        "water_trend",
        "suggested_urgency"
      ]
    }
  },
  "required": [
    "schema_version",
    "victim_location",
    "headcount",
    "required_asset",
    "hazards",
    "confidence_score",
    "needs_human_review",
    "uncertainty_reasons",
    "victim_profile"
  ],
  "description": "V2 unchanged plus victim_profile: facts about the people and conditions that drive urgency and caller-location use. The model extracts categories; urgency is derived deterministically outside the model. victim_profile never decides needs_human_review. Field order is part of the serving contract: grammar-constrained decoding generates fields in this order, and victim_profile comes last so the review decision is written before any profile uncertainty."
}
